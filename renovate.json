{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Debian base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "debian-base-image"
    },
    {
      "description": "Auto-merge when CI is green; majors stay human-merged (ADR-0012, amended)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "A version bump alters no policy: declare the ADR gate's exemption (docs/adr/README.md)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest", "bump"],
      "addLabels": ["adr-not-needed"]
    },
    {
      "description": "A major bump is a decision: the ADR gate must see it even off a structural path",
      "matchUpdateTypes": ["major"],
      "addLabels": ["needs-adr"]
    }
  ],
  "customManagers": [
    {
      "description": "Oracle tool images pinned in scripts/validate.sh (#20 Task 3)",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/validate\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+=\"[^\"]+:(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
